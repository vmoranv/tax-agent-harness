# =============================================================================
# 环境变量模板 —— 复制为 .env 后填写即可生效
#
# 用法：cp .env.example .env   （Windows: copy .env.example .env）
#   - .env 放在「仓库根目录」（与本文件同级、含 pnpm-workspace.yaml 的目录）。
#   - 复制后填入 HARNESS_LLM_API_KEY 即生效：API / Worker / CLI 三个进程在启动时
#     都会自动调用 loadEnv() 加载本文件，无需手动 export，也无需改任何代码。
#   - 已存在的进程环境变量优先（dotenv 不覆盖），方便 CI / 容器用注入值覆盖 .env。
#
# 安全提示：
#   - .env 已在 .gitignore 中，**切勿提交 .env 或任何真实密钥**到版本库。
#   - HARNESS_LLM_API_KEY 等密钥仅在进程内使用，不会写入日志，也不会在
#     /api/providers、/health 等任何 HTTP 响应里以明文回显（只回显 configured 布尔）。
# =============================================================================

# ─────────── 数据库 ───────────
# PostgreSQL（生产 / 分布式）
DATABASE_URL=postgresql://harness:harness_dev_only@localhost:5432/harness
HARNESS_DB_DRIVER=pg

# SQLite（本地开发降级，不需要 PG 时用这个）
HARNESS_SQLITE_PATH=./data/runtime/harness.db

# ─────────── Redis（API + Worker 拆分时必需）───────────
REDIS_URL=redis://localhost:6379

# ─────────── LLM（在线主链路）───────────
# 复制为 .env 后，至少填好 BASE_URL + API_KEY + MODEL，/api/providers 的
# current.configured 与 /health 的 llm.configured 即变为 true。
# OpenAI 兼容端点（OpenAI / DeepSeek / 通义 / 智谱 / vLLM / Ollama /v1 等均适用）
HARNESS_LLM_BASE_URL=https://api.example.com/v1
# 真实密钥（sk-...）。仅进程内使用，绝不进日志 / HTTP 响应明文。
HARNESS_LLM_API_KEY=sk-REPLACE_ME
HARNESS_LLM_MODEL=your-model-id
# 可选：单次 run 最大步数（默认 8）、请求超时毫秒（默认 90000）
HARNESS_LLM_MAX_STEPS=8
HARNESS_LLM_TIMEOUT_MS=90000

# ─────────── 服务 ───────────
API_PORT=9601
WORKER_CONCURRENCY=4
LOG_LEVEL=info
