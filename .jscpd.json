{
  "$schema": "https://json.schemastore.org/jscpd.json",
  "threshold": 10,
  "minTokens": 60,
  "minLines": 5,
  "maxLines": 1000,
  "path": ["packages", "apps"],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/dist-test/**",
    "**/test/**",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/fixtures/**"
  ],
  "format": ["typescript", "javascript"],
  "reporters": ["console"],
  "silent": false
}
