{
  "name": "@harness/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --no-warnings=ExperimentalWarning dist/server.js",
    "dev": "tsc -p tsconfig.json && node --no-warnings=ExperimentalWarning dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.0.0",
    "@harness/domain": "workspace:*",
    "@harness/contracts": "workspace:*",
    "@harness/application": "workspace:*",
    "@harness/adapters": "workspace:*",
    "@harness/runtime": "workspace:*",
    "fastify": "5.12.8",
    "@fastify/static": "10.1.8",
    "@fastify/cors": "11.4.0",
    "zod": "4.6.7"
  }
}
